---
import Layout from '../layouts/Layout.astro';
import CommunityWall from '../components/CommunityWall';

---

<Layout title="Quiet Thoughts | MindEase">
  <main className="min-h-screen bg-brutal-cream pb-20">
    <div className="container mx-auto px-6 pt-32 mb-12 text-center">
      <h1 className="text-4xl md:text-6xl font-heading font-black mb-6">
        <span className="inline-block bg-white border-2 border-black px-4 py-2 shadow-brutal -rotate-1">
            You Are Not Alone
        </span>
      </h1>
      <p className="text-xl max-w-2xl mx-auto font-medium text-gray-700">
        This is a safe space to let it out. No judgment. No names. Just feelings.
      </p>
    </div>

    <CommunityWall client:load />

    <div className="text-center mt-20">
        <a href="/" className="inline-block px-8 py-3 bg-white border-2 border-black font-bold uppercase hover:bg-gray-50 transition-colors">
            ← Back Home
        </a>
    </div>
  </main>
</Layout>
