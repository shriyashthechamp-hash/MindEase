generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  USER
  PSYCHOLOGIST
  ADMIN
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SessionType {
  CHAT
  VOICE
  VIDEO
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// Models

model User {
  id        String   @id @default(uuid()) // Supabase Auth ID
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile        UserProfile?
  moodLogs       MoodLog[]
  communityPosts CommunityPost[]
  reactions      Reaction[]
  sessions       Session[]
  payments       Payment[]
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  ageGroup    String? // "13-17", "18-24", etc.
  concerns    String[] // Array of concerns
  bio         String?
  isAnonymous Boolean  @default(false)
}

model Psychologist {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String
  bio             String?
  specialization  String[]
  experienceYears Int      @default(0)
  hourlyRate      Decimal  @default(0.0)
  isVerified      Boolean  @default(false)
  image           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

model MoodLog {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  mood   String // E.g., "Happy", "Anxious"
  score  Int // 1-10
  note   String?
  tags   String[] // "Work", "Sleep", etc.

  createdAt DateTime @default(now())

  @@index([userId])
}

model CommunityPost {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  content     String
  isAnonymous Boolean @default(true)

  likes   Int @default(0)
  reports Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]

  @@index([createdAt])
}

model Reaction {
  id     String        @id @default(uuid())
  userId String
  user   User          @relation(fields: [userId], references: [id])
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id])
  type   String // "Heart", "Hug", "Support"

  createdAt DateTime @default(now())

  @@unique([userId, postId, type]) // Prevent duplicate reactions of same type
}

model Session {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  psychologistId String
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  type            SessionType   @default(VIDEO)
  status          SessionStatus @default(PENDING)
  meetingLink     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?
}

model Payment {
  id        String  @id @default(uuid())
  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  amount    Decimal
  currency  String        @default("INR")
  orderId   String        @unique // Razorpay Order ID
  paymentId String? // Razorpay Payment ID
  status    PaymentStatus @default(CREATED)

  commission Decimal? // Platform fee
  payoutId   String? // For psychologist payout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
